# --- База даних ---
# Supabase: Project Settings -> Database -> Connection string (URI).
# Для free tier краще використовувати Session pooler (IPv4).
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Для локальної розробки без Supabase:
DATABASE_URL=sqlite+aiosqlite:///./kora.db

# --- API-ключі (заголовок X-API-Key). Згенеруйте:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=
API_KEY_SATELLITE=

# --- CORS (через кому, або *) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Пороги ---
TILT_WARNING_THRESHOLD=2.0
TILT_CRITICAL_THRESHOLD=5.0
DISPLACEMENT_WARNING_THRESHOLD_MM=10
DISPLACEMENT_CRITICAL_THRESHOLD_MM=25

# --- Обмеження ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_INGEST=60/minute
RATE_LIMIT_DEFAULT=120/minute
MAX_BODY_BYTES=65536
# Вимірювань на хвилину від одного пристрою (вище → 429)
DEVICE_MAX_PER_MINUTE=30
