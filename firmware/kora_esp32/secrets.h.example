#pragma once

#define WIFI_SSID "your-wifi"
#define WIFI_PASSWORD "your-wifi-password"

// Локально:  "http://192.168.1.50:8000"   (IP ноутбука в тій самій Wi-Fi мережі)
// Render:    "https://kora-backend.onrender.com"
#define API_BASE_URL "http://192.168.1.50:8000"

// ПЕРСОНАЛЬНИЙ ключ цього пристрою: поле api_key у відповіді POST /api/sensors (показується один раз)
#define API_KEY_DEVICE "paste-device-key-here"

// ID датчика, створеного через POST /api/sensors
#define SENSOR_ID 1

// Калібрування: скільки градусів відняти, коли плата лежить рівно
#define OFFSET_X 0.0f
#define OFFSET_Y 0.0f

// Як часто слати дані (мс). Ліміт бекенду — 60 запитів/хв.
#define SEND_INTERVAL_MS 30000
